# 复制为 .env 后按需修改： cp .env.example .env
# 镜像地址：本地构建就填 wxbot-wechat:latest；用私有 registry 就填 <your-registry>/wxbot-wechat:latest
WXBOT_IMAGE=wxbot-wechat:latest

# noVNC 访问密码(强烈建议设置！否则任何人可操作你的微信)
VNC_PASSWORD=change-me-please

# 端口绑定范围：127.0.0.1=仅本机(默认,最安全,配合 SSH 隧道访问)
#              0.0.0.0=对外开放(务必设 VNC_PASSWORD，并在前面加反代+认证)
BIND_HOST=127.0.0.1

# 虚拟屏幕分辨率 / 时区
SCREEN=1360x900x24
TZ=Asia/Shanghai
