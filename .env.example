# ./deploy.sh 会在 .env 不存在时自动复制本文件并生成 VNC 密码。
# GitHub Runner 发布镜像后，将这里改成 registry 中的 Ubuntu 镜像地址。
WXBOT_IMAGE=wxbot-wechat:ubuntu-24.04

# noVNC 访问密码(强烈建议设置！否则任何人可操作你的微信)
VNC_PASSWORD=GENERATE_ON_FIRST_DEPLOY

# 端口绑定范围：127.0.0.1=仅本机(默认,最安全,配合 SSH 隧道访问)
#              0.0.0.0=对外开放(务必设 VNC_PASSWORD，并在前面加反代+认证)
BIND_HOST=127.0.0.1

# 虚拟屏幕分辨率 / 时区
SCREEN=1360x900x24
TZ=Asia/Shanghai

# 后台自动化功能；按需改成 0。
WXBOT_BOT_AUTOSTART=1
WXBOT_MEDIA_CAPTURE=1
