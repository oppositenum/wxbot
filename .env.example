# ./deploy.sh 会在 .env 不存在时自动复制本文件并生成 VNC 密码。
# GitHub Runner 发布镜像后，将这里改成 registry 中的 Ubuntu 镜像地址。
WXBOT_IMAGE=wxbot-wechat:ubuntu-24.04

# noVNC 访问密码(强烈建议设置！否则任何人可操作你的微信)
VNC_PASSWORD=GENERATE_ON_FIRST_DEPLOY

# 5100 管理页登录。不要把账号密码写进代码；./deploy.sh 首次会生成。
WXBOT_UI_AUTH=1
WXBOT_UI_USER=admin
WXBOT_UI_PASSWORD=GENERATE_ON_FIRST_DEPLOY
WXBOT_SECRET=GENERATE_ON_FIRST_DEPLOY
WXBOT_UI_IDLE=600

# 端口绑定范围：127.0.0.1=仅本机(默认,最安全,配合 SSH 隧道访问)
#              0.0.0.0=对外开放(务必设 VNC_PASSWORD，并在前面加反代+认证)
BIND_HOST=127.0.0.1

# 虚拟屏幕分辨率 / 时区(1920x1080 是最常见的真人桌面分辨率,别用小众尺寸)
SCREEN=1920x1080x24
TZ=Asia/Shanghai

# 降"容器/机器人"指纹:主机名与网卡 MAC。
# WXBOT_HOSTNAME 用普通桌面主机名,别用容器默认的 12 位哈希。
# WXBOT_MAC 前三段须是真实网卡厂商 OUI(默认 00:1b:21=Intel);
# 每台部署可自定后三段以免多机重复,但别用本地管理位(第二个十六进制为 2/6/a/e)。
WXBOT_HOSTNAME=ubuntu-pc
WXBOT_MAC=00:1b:21:3a:7c:9e

# 后台自动化功能；按需改成 0。
WXBOT_BOT_AUTOSTART=1
WXBOT_MEDIA_CAPTURE=1

# 多账号 启动/停止/重启：容器内无 docker CLI，改由宿主助手代执行。
# 运行 tools/install_host_agent.sh 会自动生成 token 并写入这里、安装开机自启助手。
# WXBOT_SELF_CONTAINER 为承载管理后台、禁止被自身停止/重启的容器名。
WXBOT_SELF_CONTAINER=wxbot
WXBOT_HOST_AGENT_URL=http://host.docker.internal:5199
WXBOT_HOST_AGENT_TOKEN=
