#!/bin/bash
# Compatibility entrypoint for wxbot-ubuntu-manual.
# Same desktop/WeChat/backend startup as the original image, plus Xvfb lock
# cleanup so a host reboot or container restart does not exit on a stale :0.
set -euo pipefail
umask 077
# Sending scripts look for the Chinese main window title「微信」. Keep the
# desktop locale Chinese even when the base image lost baked-in ENV.
export LANG="${LANG:-zh_CN.UTF-8}"
export LANGUAGE="${LANGUAGE:-zh_CN:zh}"
export LC_ALL="${LC_ALL:-zh_CN.UTF-8}"
mkdir -p "$HOME/.local/state/ubuntu-wechat" "$HOME/Desktop"
LOG_DIR="$HOME/.local/state/ubuntu-wechat"
export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

disp="${DISPLAY#:}"
rm -f "/tmp/.X${disp}-lock" "/tmp/.X11-unix/X${disp}"

Xvfb "$DISPLAY" -screen 0 "$SCREEN" -ac +extension GLX +render -noreset >"$LOG_DIR/xvfb.log" 2>&1 &
for attempt in $(seq 1 40); do
    xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break
    sleep 0.25
done
xdpyinfo -display "$DISPLAY" >/dev/null
eval "$(dbus-launch --sh-syntax)"
xset s off
xset -dpms || true
xfce4-session >"$LOG_DIR/desktop.log" 2>&1 &
rm -f "$XDG_RUNTIME_DIR/pulse/pid"   # 镜像里残留的旧 pid 会让 pulseaudio 以为已在运行
pulseaudio --start --exit-idle-time=-1 || true
# 虚拟麦克风:往 vmic 播的声音会出现在默认输入 virtual_mic,用来发语音条(core/voice_bar.py)。
for _ in 1 2 3 4 5; do pactl info >/dev/null 2>&1 && break; sleep 1; done
if ! pactl list short sinks 2>/dev/null | grep -q "\bvmic\b"; then
  pactl load-module module-null-sink sink_name=vmic sink_properties=device.description=VirtualMicFeed rate=48000 channels=1 >/dev/null 2>&1 || true
  pactl load-module module-remap-source master=vmic.monitor source_name=virtual_mic source_properties=device.description=VirtualMic >/dev/null 2>&1 || true
fi
pactl set-default-source virtual_mic >/dev/null 2>&1 || true
fcitx5 -d >"$LOG_DIR/input.log" 2>&1 || true
x11vnc -display "$DISPLAY" -forever -shared -nopw -noxdamage -rfbport 5900 >"$LOG_DIR/vnc.log" 2>&1 &
websockify --web=/usr/share/novnc 6080 localhost:5900 >"$LOG_DIR/novnc.log" 2>&1 &
sleep 2
wechat >"$LOG_DIR/wechat.log" 2>&1 &
# The API now runs in the same Ubuntu container as WeChat.  This gives the
# reader, scheduler, sender and desktop all one account/session boundary.
mkdir -p /home/wechat/accounts /home/wechat/work
backend_supervisor() {
    while true; do
        echo "[$(date -Is)] starting backend" >>"$LOG_DIR/backend.log"
        token_file="$HOME/.local/state/ubuntu-wechat/api_token"
        if [ -z "${WXBOT_API_TOKEN:-}" ] && [ -f "$token_file" ]; then
            # api_token has no trailing newline, so read returns 1 at EOF.
            # set -e would otherwise kill this background supervisor.
            IFS= read -r WXBOT_API_TOKEN < "$token_file" || true
            export WXBOT_API_TOKEN
        fi
        (cd /app && exec python3 /app/server.py) >>"$LOG_DIR/backend.log" 2>&1 || true
        echo "[$(date -Is)] backend exited; restarting in 2s" >>"$LOG_DIR/backend.log"
        sleep 2
    done
}
backend_supervisor &
echo 'Ubuntu WeChat desktop and management backend ready; bot remains stopped.'
wait
